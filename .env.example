# Telegram обязателен для команды `live`.
# Токен создаётся через @BotFather. Никому его не отправляйте.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Настройки безопасного симулятора. HTX API-ключи НЕ используются.
SYMBOL=solusdt
PERIOD=1min
CAPITAL=500
FEE_RATE=0.002
SLIPPAGE_RATE=0.0002
LOOKBACK=120
MIN_RANGE_PCT=0.012
MAX_SLOPE_PCT=0.004
ENTRY_ZONE=0.30
EXIT_ZONE=0.65
MIN_TOUCHES=2
MIN_NET_PROFIT_PCT=0.0035
COOLDOWN_CANDLES=5

POLL_SECONDS=10
DATABASE_PATH=data/live_simulator.db

