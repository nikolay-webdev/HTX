# Telegram ist für den Befehl `live` erforderlich.
# Der Token wird über @BotFather erstellt. Nicht weitergeben.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Einstellungen des sicheren Simulators. HTX-API-Schlüssel werden NICHT verwendet.
SYMBOL=ethusdt
PERIOD=1min
CAPITAL=1800
MAX_OPEN_POSITIONS=2
MIN_POSITION_DISTANCE_USDT=70
FEE_RATE=0.002
SLIPPAGE_RATE=0.0002
TARGET_PRICE_DELTA=10
LOOKBACK=90
MIN_RANGE_PCT=0.008
MAX_SLOPE_PCT=0.004
ENTRY_ZONE=0.30
EXIT_ZONE=0.65
MIN_TOUCHES=2
MIN_NET_PROFIT_PCT=0.0035
COOLDOWN_CANDLES=0

# Zusätzlicher Einstieg nach einem volumenbestätigten Fehlausbruch. Kein Stop-Loss:
# Die Position bleibt bis zu einem Ziel geöffnet, das Gebühren und MIN_NET_PROFIT_PCT abdeckt.
REVERSAL_ENABLED=true
REVERSAL_LOOKBACK=60
REVERSAL_CONFIRMATION_CANDLES=15
REVERSAL_DROP_PCT=0.004
REVERSAL_REBOUND_PCT=0.0025
REVERSAL_MAX_REBOUND_PCT=0.008
REVERSAL_VOLUME_LOOKBACK=20
REVERSAL_VOLUME_MULTIPLIER=2.0

POLL_SECONDS=10
DATABASE_PATH=data/eth_live_simulator.db
